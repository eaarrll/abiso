# Copy to .env. Nothing is sent anywhere until ABISO_LIVE=1 AND the channel
# has credentials; until then every send is recorded as a dry run.
ABISO_LIVE=0

# Public DNS name for the webhook (Caddy gets a certificate for it)
ABISO_DOMAIN=

# Pilot scope
REGION=07
NOAH_PROVINCES=Cebu

# SMS (Semaphore). Sender ID must be registered with the aggregator first.
SEMAPHORE_API_KEY=
SMS_SENDER_NAME=ABISO

# Telegram channel mirror + inbound replies
TELEGRAM_BOT_TOKEN=

# Messenger inbound (user-initiated only; Meta ended broadcast push in 2026)
MESSENGER_VERIFY_TOKEN=
